<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/roundStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_your_attack"
        android:textSize="22sp" />

    <ImageView
        android:id="@+id/appHandSignImage"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_margin="24dp"
        android:contentDescription="@string/app_hand_sign_description"
        android:scaleType="fitCenter"
        android:src="@drawable/stone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonPlayStone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="@string/stone" />

        <Button
            android:id="@+id/buttonPlayScissors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="@string/scissors" />

        <Button
            android:id="@+id/buttonPlayPaper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="@string/paper" />
    </LinearLayout>

</LinearLayout>
